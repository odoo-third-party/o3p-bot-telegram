<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="o3p_bot_telegram_tester_view_form" model="ir.ui.view">
        <field name="name">o3p.bot.telegram.tester.form</field>
        <field name="model">o3p.bot.telegram.tester</field>
        <field name="arch" type="xml">
            <form string="Telegram Bot Test" edit="1" delete="0">
                <sheet>
                    <group string="Recent Chats">
                        <button name="action_get_recent_chats"
                                string="Get Recent Chats"
                                type="object"
                                class="btn-primary"
                                icon="fa-refresh"/>
                        <field name="recent_chat_result" nolabel="1" placeholder="Chat IDs and handles appear here after testing."/>
                    </group>
                    <group string="Send Message">
                        <field name="chat_id" placeholder="-1001234567890"/>
                        <field name="message_text" placeholder="Message text"/>
                        <button name="action_send_message"
                                string="Send Message"
                                type="object"
                                class="btn-primary"
                                icon="fa-paper-plane"/>
                        <field name="send_result" nolabel="1" placeholder="Telegram API response summary appears here after sending."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_o3p_bot_telegram_tester" model="ir.actions.act_window">
        <field name="name">Telegram Bot Test</field>
        <field name="res_model">o3p.bot.telegram.tester</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
